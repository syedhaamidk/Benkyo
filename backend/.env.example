# Copy this to .env and fill in your key
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to localhost:5173,localhost:3000 if unset — fine for local dev.
# Set this to your deployed Vercel/Netlify URL before going live.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional shared-secret gate to keep a public demo deployment from being
# hammered by strangers. NOT a real multi-user auth system — just requires
# every request to include header `X-Access-Key: <this value>`.
# Leave unset for local development (gate is disabled/open).
# BENKYO_ACCESS_KEY=choose-a-random-string-here
